                            <constraint firstItem="LaunchSubtitleLabel" firstAttribute="top" secondItem="LaunchTitleLabel" secondAttribute="bottom" constant="8" id="launch-subtitle-top"/>
                            <constraint firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="LaunchSubtitleLabel" secondAttribute="trailing" constant="30" id="launch-subtitle-trailing"/>
                            <constraint firstItem="LaunchTitleLabel" firstAttribute="centerX" secondItem="LaunchRootView" secondAttribute="centerX" id="launch-title-center-x"/>
                            <constraint firstItem="LaunchTitleLabel" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="LaunchRootView" secondAttribute="leading" constant="24" id="launch-title-leading"/>
                            <constraint firstItem="LaunchTitleLabel" firstAttribute="top" secondItem="LaunchIconView" secondAttribute="bottom" constant="20" id="launch-title-top"/>
                            <constraint firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="LaunchTitleLabel" secondAttribute="trailing" constant="24" id="launch-title-trailing"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LaunchFirstResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
